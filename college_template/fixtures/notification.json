    "message": "<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;\">\n    <div style=\"background: linear-gradient(135deg, #14f1b1, #0a8fdc); padding: 30px; text-align: center; border-radius: 10px 10px 0 0;\">\n      <h1 style=\"color: white; margin: 0; font-size: 24px;\">🎓 Congratulations!</h1>\n    </div>\n    <div style=\"padding: 30px; background: #fff; border: 1px solid #e0e0e0; border-top: none;\">\n      <p>Dear <strong>{{ doc.first_name }} {{ doc.last_name }}</strong>,</p>\n      <p>We are pleased to inform you that your admission application has been <strong style=\"color: #22c55e;\">approved</strong>.</p>\n      <div style=\"background: #f0fdf4; border-left: 4px solid #22c55e; padding: 15px; margin: 20px 0; border-radius: 5px;\">\n        <p style=\"margin: 0; color: #166534;\">✅ Your application is now eligible for the next admission process.</p>\n      </div>\n      <table style=\"width: 100%; border-collapse: collapse;\">\n        <tr><td style=\"padding: 8px; background: #f8f9fa;\"><strong>Application ID:</strong></td><td style=\"padding: 8px;\">{{ doc.name }}</td></tr>\n        <tr><td style=\"padding: 8px;\"><strong>Program:</strong></td><td style=\"padding: 8px;\">{{ doc.program }}</td></tr>\n        <tr><td style=\"padding: 8px; background: #f8f9fa;\"><strong>Academic Year:</strong></td><td style=\"padding: 8px;\">{{ doc.academic_year }}</td></tr>\n      </table>\n      <div style=\"text-align: center; margin-top: 30px;\">\n        <a href=\"{{ frappe.utils.get_url() }}\" style=\"display: inline-block; padding: 12px 30px; background: linear-gradient(135deg, #14f1b1, #0a8fdc); color: white; text-decoration: none; border-radius: 30px; font-weight: bold;\">View Admission Details →</a>\n      </div>\n    </div>\n    <div style=\"padding: 15px; text-align: center; font-size: 12px; color: #888; background: #f8f9fa; border-radius: 0 0 10px 10px;\">\n      Bizaxl Admissions • ERP Cloud System\n    </div>\n  </div>",
