    {"fieldname": "device_type", "label": "Type", "fieldtype": "Select", "options": "Biometric\nRFID\nFace Recognition\nCard Reader\nOther", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "serial_number", "label": "Serial Number", "fieldtype": "Data", "unique": 1},
    {"fieldname": "ip_address", "label": "IP Address", "fieldtype": "Data"},
    {"fieldname": "port", "label": "Port", "fieldtype": "Data"},
    {"fieldname": "column_break_dc", "label": "", "fieldtype": "Column Break"},
    {"fieldname": "location", "label": "Location", "fieldtype": "Data"},
    {"fieldname": "api_endpoint", "label": "API Endpoint", "fieldtype": "Data", "description": "URL for device API integration"},
    {"fieldname": "auth_token", "label": "Auth Token", "fieldtype": "Password"},
    {"fieldname": "status", "label": "Status", "fieldtype": "Select", "options": "Active\nInactive\nOffline", "default": "Active", "in_list_view": 1},
    {"fieldname": "last_sync", "label": "Last Sync", "fieldtype": "Datetime", "read_only": 1}
